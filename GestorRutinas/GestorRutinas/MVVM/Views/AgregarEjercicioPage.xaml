<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestorRutinas.MVVM.Views.AgregarEjercicioPage"
             Title="Agregar Ejercicio"
             BackgroundColor="#F5F5F5">
    <VerticalStackLayout Padding="20" Spacing="15">

        <VerticalStackLayout Spacing="5">
            <Label Text="Nombre del Ejercicio"
                   FontSize="12"
                   TextColor="#666"
                   FontAttributes="Bold"/>
            <Entry x:Name="NombreEntry"
                   Placeholder="Ej: Press de Banca"
                   PlaceholderColor="#999"
                   FontSize="14"
                   TextColor="Black"/>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Descripción (Opcional)"
                   FontSize="12"
                   TextColor="#666"
                   FontAttributes="Bold"/>
            <Editor x:Name="DescripcionEditor"
                    Placeholder="Ej: Ejercicio principal para pecho"
                    PlaceholderColor="#999"
                    FontSize="14"
                    HeightRequest="80"
                    TextColor="Black"/>
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5"/>
        <Label Text="Parámetros del Ejercicio" 
               FontSize="14" 
               FontAttributes="Bold"
               TextColor="#003366"/>
        <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5"/>

        <VerticalStackLayout Spacing="5">
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Label Text="Series"
                       FontSize="12"
                       TextColor="#666"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Label x:Name="SeriesValueLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#FF6B35"
                       VerticalOptions="Center"/>
            </StackLayout>
            <Slider x:Name="SeriesSlider"
                    Minimum="1"
                    Maximum="10"
                    Value="3"
                    ValueChanged="OnSeriesSliderChanged"
                    BackgroundColor="#E0E0E0"/>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Label Text="Repeticiones"
                       FontSize="12"
                       TextColor="#666"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Label x:Name="RepeticionesValueLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#FF6B35"
                       VerticalOptions="Center"/>
            </StackLayout>
            <Slider x:Name="RepeticionesSlider"
                    Minimum="1"
                    Maximum="30"
                    Value="8"
                    ValueChanged="OnRepeticionesSliderChanged"
                    BackgroundColor="#E0E0E0"/>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Peso (kg)"
                   FontSize="12"
                   TextColor="#666"
                   FontAttributes="Bold"/>
            <Entry x:Name="PesoEntry"
                   Placeholder="Ej: 50.5"
                   Keyboard="Numeric"
                   PlaceholderColor="#999"
                   FontSize="14"
                   TextColor="Black"/>
        </VerticalStackLayout>

        <Frame CornerRadius="10" Padding="15" BorderColor="#E0E0E0">
            <VerticalStackLayout Spacing="8">
                <Label Text="📋 Resumen"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#003366"/>
                <Label x:Name="ResumenLabel"
                       FontSize="12"
                       TextColor="#666"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Frame>

        <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
            <Button Text="Cancelar"
                    BackgroundColor="#E74C3C"
                    TextColor="White"
                    Padding="15,12"
                    CornerRadius="8"
                    FontSize="14"
                    FontAttributes="Bold"
                    Clicked="OnCancelarClicked"
                    HorizontalOptions="FillAndExpand"/>

            <Button Text="✓ Guardar"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    Padding="15,12"
                    CornerRadius="8"
                    FontSize="14"
                    FontAttributes="Bold"
                    Clicked="OnGuardarClicked"
                    HorizontalOptions="FillAndExpand"/>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>